; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Loom"
config/description="Lift the threads to weave each pattern."
config/version="0.1.0"
run/main_scene="res://core/ui/main_menu.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.949, 0.91, 0.835, 1)
boot_splash/show_image=false
config/icon="res://art/icon_192.png"

[autoload]

Save="*res://core/autoload/save.gd"
Levels="*res://core/autoload/levels.gd"
Audio="*res://core/autoload/audio.gd"
Haptics="*res://core/autoload/haptics.gd"
Analytics="*res://core/autoload/analytics.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=450
window/size/window_height_override=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

common/drop_mouse_on_gui_input_disabled=true

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.949, 0.91, 0.835, 1)
