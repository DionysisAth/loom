# Uploads the release AAB to Google Play internal testing.
# Run from CI (see .github/workflows/ci.yml) once PLAY_SERVICE_ACCOUNT_JSON is set.
# Google Play needs the very first AAB of a new app uploaded by hand in the
# Play Console; after that this lane can take over.
default_platform(:android)

platform :android do
  desc "Upload an AAB to the internal testing track"
  lane :internal do |options|
    upload_to_play_store(
      package_name: "com.dionysisath.loom",
      track: "internal",
      aab: options[:aab] || "../build/app/outputs/bundle/release/app-release.aab",
      json_key_data: ENV["PLAY_SERVICE_ACCOUNT_JSON"],
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end
end
