# Builds a signed IPA and uploads it to TestFlight.
# Run from CI (see .github/workflows/ci.yml) once these secrets exist:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64 (App Store Connect API key, admin role)
#   APPLE_TEAM_ID
# Signing is automatic: Xcode creates or fetches the certificate and profile
# through the API key.
default_platform(:ios)

platform :ios do
  desc "Signed release build to TestFlight"
  lane :beta do
    setup_ci
    key_path = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
    File.binwrite(key_path, Base64.decode64(ENV["ASC_KEY_P8_BASE64"]))
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path,
    )
    update_code_signing_settings(
      use_automatic_signing: true,
      path: "Runner.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
    )
    sh("cd ../.. && flutter build ios --release --no-codesign --build-number=#{ENV['BUILD_NUMBER'] || '1'}")
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{key_path} " \
              "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}",
      export_options: {
        method: "app-store",
        signingStyle: "automatic",
        teamID: ENV["APPLE_TEAM_ID"],
      },
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
